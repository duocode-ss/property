<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_RoleChange" name="Role Change Process" processRef="Process_RoleChange" />
  </bpmn:collaboration>

  <bpmn:process id="Process_RoleChange" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectMember</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ViewError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ViewNoChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ViewSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>ServiceTask_EvalPerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsAuthorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_EvalHierarchy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WithinAuthority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CompareRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SameRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_EvalOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OwnerProtected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ErrorMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_EvalTargetRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsOwnerRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_Transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_DemoteOwner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_UpdateRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_UpdateAssignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_LogEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ==================== USER LANE ==================== -->

    <bpmn:startEvent id="StartEvent_Initiate" name="Initiate Role Change">
      <bpmn:outgoing>Flow_Start_SelectMember</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_SelectMember" name="Select target member">
      <bpmn:incoming>Flow_Start_SelectMember</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectMember_SelectRole</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_SelectRole" name="Select desired role">
      <bpmn:incoming>Flow_SelectMember_SelectRole</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectRole_Submit</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_Submit" name="Submit role change request">
      <bpmn:incoming>Flow_SelectRole_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_EvalPerms</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ViewError" name="View error notification">
      <bpmn:incoming>Flow_ErrorMerge_ViewError</bpmn:incoming>
      <bpmn:outgoing>Flow_ViewError_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Action Rejected">
      <bpmn:incoming>Flow_ViewError_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_ViewNoChange" name="View no-change notification">
      <bpmn:incoming>Flow_GWSame_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ViewNoChange_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_NoChange" name="No Change Required">
      <bpmn:incoming>Flow_ViewNoChange_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="UserTask_ViewSuccess" name="View success confirmation">
      <bpmn:incoming>Flow_Log_ViewSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_ViewSuccess_End</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Success" name="Role Successfully Changed">
      <bpmn:incoming>Flow_ViewSuccess_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ==================== SYSTEM LANE: VALIDATION ==================== -->

    <bpmn:serviceTask id="ServiceTask_EvalPerms" name="Evaluate initiator permissions">
      <bpmn:incoming>Flow_Submit_EvalPerms</bpmn:incoming>
      <bpmn:outgoing>Flow_EvalPerms_GWAuth</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_IsAuthorized" name="Is initiator an Owner or Admin?">
      <bpmn:incoming>Flow_EvalPerms_GWAuth</bpmn:incoming>
      <bpmn:outgoing>Flow_GWAuth_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWAuth_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_EvalHierarchy" name="Evaluate role hierarchy constraints">
      <bpmn:incoming>Flow_GWAuth_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_EvalHier_GWHier</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_WithinAuthority" name="Is target role within initiator authority?">
      <bpmn:incoming>Flow_EvalHier_GWHier</bpmn:incoming>
      <bpmn:outgoing>Flow_GWHier_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWHier_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_CompareRole" name="Compare requested role with current role">
      <bpmn:incoming>Flow_GWHier_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Compare_GWSame</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_SameRole" name="Is requested role same as current?">
      <bpmn:incoming>Flow_Compare_GWSame</bpmn:incoming>
      <bpmn:outgoing>Flow_GWSame_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWSame_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_EvalOwner" name="Evaluate Owner protection rules">
      <bpmn:incoming>Flow_GWSame_No</bpmn:incoming>
      <bpmn:outgoing>Flow_EvalOwner_GWOwner</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OwnerProtected" name="Is target user the current Owner?">
      <bpmn:incoming>Flow_EvalOwner_GWOwner</bpmn:incoming>
      <bpmn:outgoing>Flow_GWOwner_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWOwner_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_ErrorMerge">
      <bpmn:incoming>Flow_GWAuth_No</bpmn:incoming>
      <bpmn:incoming>Flow_GWHier_No</bpmn:incoming>
      <bpmn:incoming>Flow_GWOwner_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrorMerge_ViewError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ==================== SYSTEM LANE: EXECUTION ==================== -->

    <bpmn:serviceTask id="ServiceTask_EvalTargetRole" name="Evaluate target role type">
      <bpmn:incoming>Flow_GWOwner_No</bpmn:incoming>
      <bpmn:outgoing>Flow_EvalTarget_GWIsOwner</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_IsOwnerRole" name="Is the new role &#39;Owner&#39;?">
      <bpmn:incoming>Flow_EvalTarget_GWIsOwner</bpmn:incoming>
      <bpmn:outgoing>Flow_GWIsOwner_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWIsOwner_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_Transfer" name="Execute Ownership Transfer Routine">
      <bpmn:incoming>Flow_GWIsOwner_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Transfer_DemoteOwner</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_DemoteOwner" name="Demote previous Owner to Admin">
      <bpmn:incoming>Flow_Transfer_DemoteOwner</bpmn:incoming>
      <bpmn:outgoing>Flow_DemoteOwner_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_UpdateRole" name="Update target user role">
      <bpmn:incoming>Flow_GWIsOwner_No</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateRole_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_MergeExec">
      <bpmn:incoming>Flow_DemoteOwner_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_UpdateRole_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_UpdateAssignment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_UpdateAssignment" name="Update user role assignment in database">
      <bpmn:incoming>Flow_Merge_UpdateAssignment</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateAssignment_Log</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_LogEvent" name="Log role change event">
      <bpmn:incoming>Flow_UpdateAssignment_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_ViewSuccess</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ==================== SEQUENCE FLOWS ==================== -->

    <bpmn:sequenceFlow id="Flow_Start_SelectMember"
                       sourceRef="StartEvent_Initiate"
                       targetRef="UserTask_SelectMember" />
    <bpmn:sequenceFlow id="Flow_SelectMember_SelectRole"
                       sourceRef="UserTask_SelectMember"
                       targetRef="UserTask_SelectRole" />
    <bpmn:sequenceFlow id="Flow_SelectRole_Submit"
                       sourceRef="UserTask_SelectRole"
                       targetRef="UserTask_Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_EvalPerms"
                       sourceRef="UserTask_Submit"
                       targetRef="ServiceTask_EvalPerms" />
    <bpmn:sequenceFlow id="Flow_EvalPerms_GWAuth"
                       sourceRef="ServiceTask_EvalPerms"
                       targetRef="Gateway_IsAuthorized" />
    <bpmn:sequenceFlow id="Flow_GWAuth_Yes" name="Yes"
                       sourceRef="Gateway_IsAuthorized"
                       targetRef="ServiceTask_EvalHierarchy" />
    <bpmn:sequenceFlow id="Flow_GWAuth_No" name="No - Unauthorized"
                       sourceRef="Gateway_IsAuthorized"
                       targetRef="Gateway_ErrorMerge" />
    <bpmn:sequenceFlow id="Flow_EvalHier_GWHier"
                       sourceRef="ServiceTask_EvalHierarchy"
                       targetRef="Gateway_WithinAuthority" />
    <bpmn:sequenceFlow id="Flow_GWHier_Yes" name="Yes"
                       sourceRef="Gateway_WithinAuthority"
                       targetRef="ServiceTask_CompareRole" />
    <bpmn:sequenceFlow id="Flow_GWHier_No" name="No - Hierarchy Violated"
                       sourceRef="Gateway_WithinAuthority"
                       targetRef="Gateway_ErrorMerge" />
    <bpmn:sequenceFlow id="Flow_Compare_GWSame"
                       sourceRef="ServiceTask_CompareRole"
                       targetRef="Gateway_SameRole" />
    <bpmn:sequenceFlow id="Flow_GWSame_Yes" name="Yes - No Change"
                       sourceRef="Gateway_SameRole"
                       targetRef="UserTask_ViewNoChange" />
    <bpmn:sequenceFlow id="Flow_GWSame_No" name="No"
                       sourceRef="Gateway_SameRole"
                       targetRef="ServiceTask_EvalOwner" />
    <bpmn:sequenceFlow id="Flow_EvalOwner_GWOwner"
                       sourceRef="ServiceTask_EvalOwner"
                       targetRef="Gateway_OwnerProtected" />
    <bpmn:sequenceFlow id="Flow_GWOwner_Yes" name="Yes - Owner Protected"
                       sourceRef="Gateway_OwnerProtected"
                       targetRef="Gateway_ErrorMerge" />
    <bpmn:sequenceFlow id="Flow_GWOwner_No" name="No"
                       sourceRef="Gateway_OwnerProtected"
                       targetRef="ServiceTask_EvalTargetRole" />
    <bpmn:sequenceFlow id="Flow_ErrorMerge_ViewError"
                       sourceRef="Gateway_ErrorMerge"
                       targetRef="UserTask_ViewError" />
    <bpmn:sequenceFlow id="Flow_ViewError_End"
                       sourceRef="UserTask_ViewError"
                       targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_ViewNoChange_End"
                       sourceRef="UserTask_ViewNoChange"
                       targetRef="EndEvent_NoChange" />
    <bpmn:sequenceFlow id="Flow_EvalTarget_GWIsOwner"
                       sourceRef="ServiceTask_EvalTargetRole"
                       targetRef="Gateway_IsOwnerRole" />
    <bpmn:sequenceFlow id="Flow_GWIsOwner_Yes" name="Yes"
                       sourceRef="Gateway_IsOwnerRole"
                       targetRef="ServiceTask_Transfer" />
    <bpmn:sequenceFlow id="Flow_GWIsOwner_No" name="No"
                       sourceRef="Gateway_IsOwnerRole"
                       targetRef="ServiceTask_UpdateRole" />
    <bpmn:sequenceFlow id="Flow_Transfer_DemoteOwner"
                       sourceRef="ServiceTask_Transfer"
                       targetRef="ServiceTask_DemoteOwner" />
    <bpmn:sequenceFlow id="Flow_DemoteOwner_Merge"
                       sourceRef="ServiceTask_DemoteOwner"
                       targetRef="Gateway_MergeExec" />
    <bpmn:sequenceFlow id="Flow_UpdateRole_Merge"
                       sourceRef="ServiceTask_UpdateRole"
                       targetRef="Gateway_MergeExec" />
    <bpmn:sequenceFlow id="Flow_Merge_UpdateAssignment"
                       sourceRef="Gateway_MergeExec"
                       targetRef="ServiceTask_UpdateAssignment" />
    <bpmn:sequenceFlow id="Flow_UpdateAssignment_Log"
                       sourceRef="ServiceTask_UpdateAssignment"
                       targetRef="ServiceTask_LogEvent" />
    <bpmn:sequenceFlow id="Flow_Log_ViewSuccess"
                       sourceRef="ServiceTask_LogEvent"
                       targetRef="UserTask_ViewSuccess" />
    <bpmn:sequenceFlow id="Flow_ViewSuccess_End"
                       sourceRef="UserTask_ViewSuccess"
                       targetRef="EndEvent_Success" />

  </bpmn:process>

  <!-- ============================================================ -->
  <!-- BPMN DIAGRAM INTERCHANGE (DI)                                -->
  <!-- ============================================================ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <!-- Pool -->
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_RoleChange" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="4000" height="780" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="150" y="40" width="3970" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="150" y="280" width="3970" height="540" />
      </bpmndi:BPMNShape>

      <!-- ======== USER LANE SHAPES ======== -->

      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent_Initiate">
        <dc:Bounds x="222" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="202" y="185" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_SelectMember_di" bpmnElement="UserTask_SelectMember">
        <dc:Bounds x="320" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_SelectRole_di" bpmnElement="UserTask_SelectRole">
        <dc:Bounds x="540" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_Submit_di" bpmnElement="UserTask_Submit">
        <dc:Bounds x="760" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_ViewError_di" bpmnElement="UserTask_ViewError">
        <dc:Bounds x="1200" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1420" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1398" y="185" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_ViewNoChange_di" bpmnElement="UserTask_ViewNoChange">
        <dc:Bounds x="1750" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_NoChange_di" bpmnElement="EndEvent_NoChange">
        <dc:Bounds x="1970" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1935" y="185" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_ViewSuccess_di" bpmnElement="UserTask_ViewSuccess">
        <dc:Bounds x="3700" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="3920" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3892" y="185" width="92" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ======== SYSTEM LANE SHAPES ======== -->

      <bpmndi:BPMNShape id="ServiceTask_EvalPerms_di" bpmnElement="ServiceTask_EvalPerms">
        <dc:Bounds x="760" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_IsAuthorized_di" bpmnElement="Gateway_IsAuthorized" isMarkerVisible="true">
        <dc:Bounds x="980" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="955" y="372" width="100" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_EvalHierarchy_di" bpmnElement="ServiceTask_EvalHierarchy">
        <dc:Bounds x="1100" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_WithinAuthority_di" bpmnElement="Gateway_WithinAuthority" isMarkerVisible="true">
        <dc:Bounds x="1320" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1280" y="368" width="130" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_CompareRole_di" bpmnElement="ServiceTask_CompareRole">
        <dc:Bounds x="1440" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_SameRole_di" bpmnElement="Gateway_SameRole" isMarkerVisible="true">
        <dc:Bounds x="1660" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1625" y="372" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_EvalOwner_di" bpmnElement="ServiceTask_EvalOwner">
        <dc:Bounds x="1780" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_OwnerProtected_di" bpmnElement="Gateway_OwnerProtected" isMarkerVisible="true">
        <dc:Bounds x="2000" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1968" y="368" width="114" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Error Merge: far-left bottom of System lane -->
      <bpmndi:BPMNShape id="Gateway_ErrorMerge_di" bpmnElement="Gateway_ErrorMerge" isMarkerVisible="true">
        <dc:Bounds x="700" y="640" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_EvalTargetRole_di" bpmnElement="ServiceTask_EvalTargetRole">
        <dc:Bounds x="2200" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_IsOwnerRole_di" bpmnElement="Gateway_IsOwnerRole" isMarkerVisible="true">
        <dc:Bounds x="2420" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2400" y="375" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_Transfer_di" bpmnElement="ServiceTask_Transfer">
        <dc:Bounds x="2540" y="320" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_DemoteOwner_di" bpmnElement="ServiceTask_DemoteOwner">
        <dc:Bounds x="2760" y="320" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_UpdateRole_di" bpmnElement="ServiceTask_UpdateRole">
        <dc:Bounds x="2540" y="520" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MergeExec_di" bpmnElement="Gateway_MergeExec" isMarkerVisible="true">
        <dc:Bounds x="2980" y="415" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_UpdateAssignment_di" bpmnElement="ServiceTask_UpdateAssignment">
        <dc:Bounds x="3100" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ServiceTask_LogEvent_di" bpmnElement="ServiceTask_LogEvent">
        <dc:Bounds x="3320" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>

      <!-- ======== SEQUENCE FLOW EDGES ======== -->

      <!-- User Lane: Start flow -->
      <bpmndi:BPMNEdge id="Flow_Start_SelectMember_di" bpmnElement="Flow_Start_SelectMember">
        <di:waypoint x="258" y="160" />
        <di:waypoint x="320" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SelectMember_SelectRole_di" bpmnElement="Flow_SelectMember_SelectRole">
        <di:waypoint x="480" y="160" />
        <di:waypoint x="540" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_SelectRole_Submit_di" bpmnElement="Flow_SelectRole_Submit">
        <di:waypoint x="700" y="160" />
        <di:waypoint x="760" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Cross-lane: Submit down to EvalPerms (straight vertical) -->
      <bpmndi:BPMNEdge id="Flow_Submit_EvalPerms_di" bpmnElement="Flow_Submit_EvalPerms">
        <di:waypoint x="840" y="200" />
        <di:waypoint x="840" y="400" />
      </bpmndi:BPMNEdge>

      <!-- Validation chain -->
      <bpmndi:BPMNEdge id="Flow_EvalPerms_GWAuth_di" bpmnElement="Flow_EvalPerms_GWAuth">
        <di:waypoint x="920" y="440" />
        <di:waypoint x="980" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GWAuth_Yes_di" bpmnElement="Flow_GWAuth_Yes">
        <di:waypoint x="1030" y="440" />
        <di:waypoint x="1100" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1040" y="420" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- GW_Auth No: down to y=600, left to merge top -->
      <bpmndi:BPMNEdge id="Flow_GWAuth_No_di" bpmnElement="Flow_GWAuth_No">
        <di:waypoint x="1005" y="465" />
        <di:waypoint x="1005" y="600" />
        <di:waypoint x="725" y="600" />
        <di:waypoint x="725" y="640" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1015" y="525" width="95" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_EvalHier_GWHier_di" bpmnElement="Flow_EvalHier_GWHier">
        <di:waypoint x="1260" y="440" />
        <di:waypoint x="1320" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GWHier_Yes_di" bpmnElement="Flow_GWHier_Yes">
        <di:waypoint x="1370" y="440" />
        <di:waypoint x="1440" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1380" y="420" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- GW_Hier No: down to y=665, left to merge right -->
      <bpmndi:BPMNEdge id="Flow_GWHier_No_di" bpmnElement="Flow_GWHier_No">
        <di:waypoint x="1345" y="465" />
        <di:waypoint x="1345" y="665" />
        <di:waypoint x="750" y="665" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="672" width="130" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Compare_GWSame_di" bpmnElement="Flow_Compare_GWSame">
        <di:waypoint x="1600" y="440" />
        <di:waypoint x="1660" y="440" />
      </bpmndi:BPMNEdge>

      <!-- GW_SameRole Yes: up to User lane, right to ViewNoChange -->
      <bpmndi:BPMNEdge id="Flow_GWSame_Yes_di" bpmnElement="Flow_GWSame_Yes">
        <di:waypoint x="1685" y="415" />
        <di:waypoint x="1685" y="160" />
        <di:waypoint x="1750" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1600" y="290" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GWSame_No_di" bpmnElement="Flow_GWSame_No">
        <di:waypoint x="1710" y="440" />
        <di:waypoint x="1780" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1720" y="420" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_EvalOwner_GWOwner_di" bpmnElement="Flow_EvalOwner_GWOwner">
        <di:waypoint x="1940" y="440" />
        <di:waypoint x="2000" y="440" />
      </bpmndi:BPMNEdge>

      <!-- GW_Owner Yes: down to y=720, left to merge bottom -->
      <bpmndi:BPMNEdge id="Flow_GWOwner_Yes_di" bpmnElement="Flow_GWOwner_Yes">
        <di:waypoint x="2025" y="465" />
        <di:waypoint x="2025" y="720" />
        <di:waypoint x="725" y="720" />
        <di:waypoint x="725" y="690" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1300" y="726" width="130" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GWOwner_No_di" bpmnElement="Flow_GWOwner_No">
        <di:waypoint x="2050" y="440" />
        <di:waypoint x="2200" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2070" y="420" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Error Merge output: left-up via y=100 to ViewError in User lane -->
      <bpmndi:BPMNEdge id="Flow_ErrorMerge_ViewError_di" bpmnElement="Flow_ErrorMerge_ViewError">
        <di:waypoint x="700" y="665" />
        <di:waypoint x="705" y="665" />
        <di:waypoint x="705" y="100" />
        <di:waypoint x="1280" y="100" />
        <di:waypoint x="1280" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ViewError_End_di" bpmnElement="Flow_ViewError_End">
        <di:waypoint x="1360" y="160" />
        <di:waypoint x="1420" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ViewNoChange_End_di" bpmnElement="Flow_ViewNoChange_End">
        <di:waypoint x="1910" y="160" />
        <di:waypoint x="1970" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Execution chain -->
      <bpmndi:BPMNEdge id="Flow_EvalTarget_GWIsOwner_di" bpmnElement="Flow_EvalTarget_GWIsOwner">
        <di:waypoint x="2360" y="440" />
        <di:waypoint x="2420" y="440" />
      </bpmndi:BPMNEdge>

      <!-- GW_IsOwner Yes: up to Transfer (upper branch) -->
      <bpmndi:BPMNEdge id="Flow_GWIsOwner_Yes_di" bpmnElement="Flow_GWIsOwner_Yes">
        <di:waypoint x="2445" y="415" />
        <di:waypoint x="2445" y="360" />
        <di:waypoint x="2540" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2460" y="335" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- GW_IsOwner No: down to UpdateRole (lower branch) -->
      <bpmndi:BPMNEdge id="Flow_GWIsOwner_No_di" bpmnElement="Flow_GWIsOwner_No">
        <di:waypoint x="2445" y="465" />
        <di:waypoint x="2445" y="560" />
        <di:waypoint x="2540" y="560" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2460" y="500" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Transfer_DemoteOwner_di" bpmnElement="Flow_Transfer_DemoteOwner">
        <di:waypoint x="2700" y="360" />
        <di:waypoint x="2760" y="360" />
      </bpmndi:BPMNEdge>

      <!-- DemoteOwner to MergeExec (upper to center) -->
      <bpmndi:BPMNEdge id="Flow_DemoteOwner_Merge_di" bpmnElement="Flow_DemoteOwner_Merge">
        <di:waypoint x="2920" y="360" />
        <di:waypoint x="3005" y="360" />
        <di:waypoint x="3005" y="415" />
      </bpmndi:BPMNEdge>

      <!-- UpdateRole to MergeExec (lower to center) -->
      <bpmndi:BPMNEdge id="Flow_UpdateRole_Merge_di" bpmnElement="Flow_UpdateRole_Merge">
        <di:waypoint x="2700" y="560" />
        <di:waypoint x="3005" y="560" />
        <di:waypoint x="3005" y="465" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Merge_UpdateAssignment_di" bpmnElement="Flow_Merge_UpdateAssignment">
        <di:waypoint x="3030" y="440" />
        <di:waypoint x="3100" y="440" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_UpdateAssignment_Log_di" bpmnElement="Flow_UpdateAssignment_Log">
        <di:waypoint x="3260" y="440" />
        <di:waypoint x="3320" y="440" />
      </bpmndi:BPMNEdge>

      <!-- Cross-lane: LogEvent up to ViewSuccess in User lane -->
      <bpmndi:BPMNEdge id="Flow_Log_ViewSuccess_di" bpmnElement="Flow_Log_ViewSuccess">
        <di:waypoint x="3480" y="440" />
        <di:waypoint x="3580" y="440" />
        <di:waypoint x="3580" y="160" />
        <di:waypoint x="3700" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ViewSuccess_End_di" bpmnElement="Flow_ViewSuccess_End">
        <di:waypoint x="3860" y="160" />
        <di:waypoint x="3920" y="160" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
